@model Movie
<div class="container">
	<div class="row mb-3 align-items-center my-3">
		<div class="col-md-6">
			<h2 class="display-6">Add new Movie</h2>
		</div>
	</div>

	<div class="row my-3">
		<div class="col-12">
			<form method="post" enctype="multipart/form-data">
				<div class="mb-3">
					<label asp-for="Name" class="form-label"></label>
					<input asp-for="Name" class="form-control" />
					<span asp-validation-for="Name" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<div class="form-floating">
						<textarea asp-for="Description" class="form-control" placeholder="Your description here..." style="height: 100px"></textarea>
						<label asp-for="Description">Your description here...</label>
					</div>
				</div>

				<div class="mb-3">
					<label for="Rating" class="form-label">Rating</label>
					<input id="Rating" type="number" class="form-control" asp-for="Rating"
						   min="0" max="10" step="1" />

					<span asp-validation-for="Rating" class="text-danger"></span>

				</div>

				<div class="mb-3">
					<label for="Price" class="form-label">Price</label>
					<input asp-for="Price" type="number" class="form-control" min="0" step="0.01" />
					<span asp-validation-for="Price" class="text-danger"></span>
				</div>

				<div class="row">
					<div class="col-md-6 mb-3">
						<label for="Date" class="form-label">Date</label>
						<input id="Date" type="date" class="form-control" asp-for="Date" />

						<span asp-validation-for="Date" class="text-danger"></span>
					</div>
					<div class="col-md-6 mb-3">
						<label for="Time" class="form-label">Time</label>
						<input id="Time" type="time" class="form-control" asp-for="Time" />

						<span asp-validation-for="Time" class="text-danger"></span>
					</div>
				</div>

				<div class="mb-3">
					<label for="status" class="form-label">Status</label>
					<select id="status" class="form-select" asp-for="Status">
						<option value="true" >Active</option>
						<option value="false">Inactive</option>
					</select>

					<span asp-validation-for="Status" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label for="Img" class="form-label">Img</label>
					<input id="Img" type="file" class="form-control" name="Imagefile" value="MainImg"
						   accept="image/*" onchange="previewImage(event)">

					<span asp-validation-for="MainImg" class="text-danger"></span>
					<img id="preview" alt="Preview" class="img-thumbnail mt-2"
						 style="max-height: 200px; display: none;" />
				</div>

				<div class="mb-3">
					<label for="SubImgs" class="form-label">Sub Images</label>
					<input id="SubImgs" type="file" class="form-control" name="SubImgFiles" value="SubImgs"
						   accept="image/*" multiple onchange="previewSubImages(event)">

					<span asp-validation-for="SubImgs" class="text-danger"></span>
					<div id="subPreview" class="d-flex flex-wrap gap-2 mt-2"></div>
				</div>

				<div class="mb-3">
					<label for="CategoryId" class="form-label">Category</label>
					<select class="form-select" asp-for="CategoryId">
						<option value="1" >Action and Adventure</option>
						<option value="2">Drama</option>
						<option value="3">Horror</option>
						<option value="4">Science Fiction</option>
						<option value="5">Fantasy</option>
						<option value="6">Romance</option>
						<option value="7">Thriller and Mystery</option>
						<option value="8">Western</option>
						<option value="9">Musical</option>
						<option value="10">Comedy</option>
					</select>

					<span asp-validation-for="CategoryId" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label for="CimaId" class="form-label">Cinema</label>
					<select class="form-select" asp-for="CimaId">
						<option value="1" >Cinéma Studio 28</option>
						<option value="2">Plaza Theatre</option>
						<option value="3">Americana Plaza</option>
						<option value="4">Curzon Bloomsbury</option>
						<option value="5">Grand Rex</option>
						<option value="6">New Beverly Cinema</option>
					</select>

					<span asp-validation-for="CimaId" class="text-danger"></span>
				</div>
				<div class="mb-3">
					<label for="Actors" class="form-label">Actors</label>

					@{
						var selectedActors = (ViewBag.SelectedActorIds as List<int>) ?? new List<int>();
					}

					<select id="Actors" class="form-select" name="ActorIds" multiple size="6">
						@foreach (var actor in (IEnumerable<Actor>)ViewBag.Actors)
						{
							<option value="@actor.Id" selected="@selectedActors.Contains(actor.Id)">@actor.Name</option>
						}
					</select>
					<div class="form-text">Hold Ctrl (Cmd on Mac) to select multiple actors.</div>

					<span asp-validation-for="Actors" class="text-danger"></span>
				</div>
				<button type="submit" class="btn btn-primary">Submit</button>
			</form>
			@* <div asp-validation-summary="All" class="text-danger"></div> *@
		</div>
	</div>
</div>
@section Scripts {
	<partial name="_NotificationPartial" />
	<partial name="_ValidationScriptsPartial" />
}
<script>
	function previewImage(event) {
		const file = event.target.files[0];
		const preview = document.getElementById("preview");
		if (!file) return;

		const reader = new FileReader();
		reader.onload = function (e) {
			preview.src = e.target.result;
			preview.style.display = "block";
		};
		reader.readAsDataURL(file);
	}

	function previewSubImages(event) {
		const container = document.getElementById("subPreview");
		container.innerHTML = "";

		Array.from(event.target.files).forEach(function (file) {
			const reader = new FileReader();
			reader.onload = function (e) {
				const img = document.createElement("img");
				img.src = e.target.result;
				img.alt = "Sub image preview";
				img.className = "img-thumbnail";
				img.style.height = "120px";
				container.appendChild(img);
			};
			reader.readAsDataURL(file);
		});
	}
</script>

