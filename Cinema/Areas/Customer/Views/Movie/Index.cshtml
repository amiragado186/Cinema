@using Cinema.ViewModels
@model FilterVM
<!-- Filter Section -->
<section class="py-3 filter-bar">
    <div class="container">
        <div class="bg-light rounded p-3">
            <form method="get" asp-area="Customer" asp-controller="Movie" asp-action="Index">
                <div class="row g-2">

                    <!-- Movie Name -->
                    <div class="col-md-3">
                        <input type="text" name="name" value="@Model.Name"
                               class="form-control" placeholder="Movie Name" />
                    </div>

                    <!-- Category -->
                    <div class="col-md-3">
                        <select name="categoryId" class="form-select">
                            <option value="">-- Select Category --</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Cinema -->
                    <div class="col-md-3">
                        <select name="cinemaId" class="form-select">
                            <option value="">-- Select Cinema --</option>
                            @foreach (var c in Model.Cinemas)
                            {
                                <option value="@c.Id" selected="@(Model.CinemaId == c.Id)">@c.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Sort -->
                    <div class="col-md-3">
                        <select name="sort" class="form-select">
                            <option value="recommended" selected="@(Model.Sort == "recommended")">Recommended</option>
                            <option value="newest" selected="@(Model.Sort == "newest")">Newest</option>
                            <option value="name" selected="@(Model.Sort == "name")">Name (A-Z)</option>
                            <option value="price_asc" selected="@(Model.Sort == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(Model.Sort == "price_desc")">Price: High to Low</option>
                        </select>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-dark w-100">Filter</button>
                    </div>
                    <div class="col-md-2">
                        <a asp-area="Customer" asp-controller="Movie" asp-action="Index"
                           class="btn btn-outline-secondary w-100">Reset</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
<div class="container py-4">
    <h2 class="mb-4">Now Showing</h2>

    <div class="row g-4">
        @foreach (var movie in Model.Movies)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <img src="~/images/movies/@movie.MainImg" class="card-img-top" alt="@movie.Name"
                         style="height: 350px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@movie.Name</h5>
                        <p class="card-text text-muted small">@movie.Description</p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="fw-bold">@movie.Price EGP</span>
                            <a asp-area="Customer" asp-controller="Booking" asp-action="Create" asp-route-movieId="@movie.Id"
                               class="btn btn-primary btn-sm">Book Now</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>