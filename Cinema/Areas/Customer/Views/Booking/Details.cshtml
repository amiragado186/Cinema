@model Cinema.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<div class="container my-4">
    <div class="card shadow-sm mx-auto" style="max-width:800px;">
        <div class="row g-0">
            <div class="col-md-4">
                <img src="~/images/@Model.Movie.MainImg" alt="@Model.Movie.Name"
                     class="img-fluid rounded-start h-100" style="object-fit:cover;" />
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h3 class="card-title">@Model.Movie.Name</h3>
                        @if (Model.Status == "Cancelled")
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@Model.Status</span>
                        }
                    </div>

                    <hr />

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Booking #</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4">Date</dt>
                        <dd class="col-sm-8">@Model.MovieDate</dd>

                        <dt class="col-sm-4">Time</dt>
                        <dd class="col-sm-8">@Model.MovieTime</dd>

                        <dt class="col-sm-4">Seats</dt>
                        <dd class="col-sm-8">@Model.SeatsCount</dd>

                        <dt class="col-sm-4">Total Price</dt>
                        <dd class="col-sm-8 fw-bold">@Model.TotalPrice.ToString("N2")</dd>

                        <dt class="col-sm-4">Booked On</dt>
                        <dd class="col-sm-8">@Model.BookingDate.ToString("yyyy-MM-dd HH:mm")</dd>
                    </dl>

                    <div class="mt-4">
                        <a asp-area="Customer" asp-controller="Booking" asp-action="Index"
                           class="btn btn-secondary">Back to Bookings</a>

                        @if (Model.Status != "Cancelled")
                        {
                            <a asp-area="Customer" asp-controller="Booking" asp-action="Cancel" asp-route-id="@Model.Id"
                               class="btn btn-warning"
                               onclick="return confirm('Cancel this booking?');">Cancel Booking</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>